{
  "compilerOptions": {
    "target": "es2019",
    "lib": ["dom", "es2019"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "node",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/admin/**/*.tsx", "src/admin/**/*.ts"]
}
