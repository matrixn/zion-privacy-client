{
  "name": "zion-privacy/zion-privacy-client",
  "description": "WordPress client for the Zion Privacy API.",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=8.1",
    "zion/wordpress-license-sdk": "^0.4.12"
  },
  "autoload": {
    "psr-4": {
      "ZionPrivacy\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs"
  }
}
